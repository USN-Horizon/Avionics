{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-G", "Visual Studio 17 2022"],
            "problemMatcher": []
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug"],
            "dependsOn": "cmake configure",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        }
    ]
}
